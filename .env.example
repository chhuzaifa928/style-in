# ─────────────────────────────────────────────────────────────
# StyleIn — Environment Variables
# Copy this file to `.env` (local dev) and set the same keys in
# Hostinger hPanel → Node.js app → Environment Variables (production).
# NEVER commit the real .env file.
# ─────────────────────────────────────────────────────────────

# ── MySQL (Hostinger managed DB, created in hPanel → Databases → MySQL) ──
DB_HOST=localhost
DB_PORT=3306
DB_USER=uXXXXXXXX_stylein
DB_PASSWORD=change-me-strong-password
DB_NAME=uXXXXXXXX_stylein

# ── Admin session signing secret ──
# Generate once with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be long & random. Rotating it invalidates all admin sessions.
SESSION_SECRET=replace-with-a-64+char-random-hex-string

# ── Session cookie hardening ──
# Set to "true" in production (HTTPS). Leave "false" for local http dev.
COOKIE_SECURE=true

# ── Public site origin (used for CSRF origin verification) ──
# e.g. https://stylein.com.pk  — no trailing slash.
APP_ORIGIN=https://your-domain.com

# ── Node runtime ──
NODE_ENV=production
PORT=3000
